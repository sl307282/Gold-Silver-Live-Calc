    <!-- Understanding HUID Bottom Sheet -->
    <string name="sheet_understanding_huid_title">Understanding HUID</string>
    <string name="close_cd">Close</string>
    <string name="sheet_section_definition">HUID (Hallmark Unique Identification) is a 6-character alphanumeric code (e.g. AB12C3) laser-engraved on every BIS-hallmarked gold or silver piece. It is unique to that item and is registered in the BIS database, so it can be traced back to the jeweller and the Assaying &amp; Hallmarking Centre that tested it.</string>
    <string name="sheet_section_three_marks_title">A valid hallmark has three marks</string>
    <string name="sheet_section_where_to_find_title">Where to find it</string>
    <string name="sheet_section_where_to_find_body">Usually on the inside of a ring, the clasp of a chain, or the back of a pendant. It\'s very small — use a magnifier or your phone\'s camera zoom.</string>
    <string name="sheet_section_how_to_verify_title">How to verify</string>
    <string name="sheet_step_1">Open the BIS CARE app (official, by Bureau of Indian Standards).</string>
    <string name="sheet_step_2">Go to \"Verify HUID\" and enter the 6-character code.</string>
    <string name="sheet_step_3">Match the jeweller name, purity and AHC shown with your bill and the piece.</string>
    <string name="sheet_disclaimer">This app does not verify HUIDs itself. Verification is done by the official BIS platform.</string>
