<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. -->
    <style name="Theme.GoldSilverLiveCalc" parent="Theme.AppCompat.NoActionBar">
        <item name="android:statusBarColor">#050505</item>
        <item name="android:navigationBarColor">#050505</item>
        <item name="android:windowBackground">#050505</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m" xmlns:tools="http://schemas.android.com/tools">false</item>
    </style>

    <!-- Legacy Splash Screen Theme (Android 11 and below) -->
    <!-- Bypasses AndroidX core-splashscreen because it doesn't support bottom branding -->
    <style name="Theme.GoldSilverLiveCalc.Splash" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background_legacy</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
    </style>
</resources>
