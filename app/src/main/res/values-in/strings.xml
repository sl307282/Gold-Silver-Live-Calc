    <string name="sheet_section_where_to_find_title">Di mana menemukannya</string>
    <string name="sheet_section_where_to_find_body">Biasanya di bagian dalam cincin, gesper kalung, atau bagian belakang liontin. Sangat kecil — gunakan kaca pembesar atau zoom kamera ponsel.</string>
    <string name="sheet_section_how_to_verify_title">Cara memverifikasi</string>
    <string name="sheet_step_1">Buka aplikasi BIS CARE (resmi, oleh Biro Standar India).</string>
    <string name="sheet_step_2">Pergi ke \"Verifikasi HUID\" dan masukkan kode 6 karakter.</string>
    <string name="sheet_step_3">Cocokkan nama toko perhiasan, kemurnian, dan AHC yang ditampilkan dengan nota dan item Anda.</string>
    <string name="sheet_disclaimer">Aplikasi ini tidak memverifikasi HUID sendiri. Verifikasi dilakukan oleh platform resmi BIS.</string>

